{
  "manifest_version": 3,
  "name": "AI Chat Exporter",
  "version": "2.0.0",
  "description": "Draw from every AI; grow your own intelligence. Export Gemini, ChatGPT, Claude, Meta AI, WhatsApp Web and self-hosted OpenWebUI conversations to Markdown.",
  "permissions": [
    "activeTab",
    "scripting",
    "downloads",
    "storage",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://gemini.google.com/*",
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://claude.ai/*",
    "https://meta.ai/*",
    "https://www.meta.ai/*",
    "https://web.whatsapp.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background/service_worker.js"
  },
  "content_scripts": [
    {
      "matches": ["https://gemini.google.com/*"],
      "js": [
        "lib/turndown.min.js",
        "lib/turndown-plugin-gfm.min.js",
        "content/adapter-registry.js",
        "content/adapters/gemini.js",
        "content/content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"],
      "js": [
        "lib/turndown.min.js",
        "lib/turndown-plugin-gfm.min.js",
        "content/adapter-registry.js",
        "content/adapters/chatgpt.js",
        "content/content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://claude.ai/*"],
      "js": [
        "lib/turndown.min.js",
        "lib/turndown-plugin-gfm.min.js",
        "content/adapter-registry.js",
        "content/adapters/claude.js",
        "content/content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://meta.ai/*", "https://www.meta.ai/*"],
      "js": [
        "lib/turndown.min.js",
        "lib/turndown-plugin-gfm.min.js",
        "content/adapter-registry.js",
        "content/adapters/meta.js",
        "content/content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": [
        "lib/turndown.min.js",
        "lib/turndown-plugin-gfm.min.js",
        "content/adapter-registry.js",
        "content/adapters/whatsapp.js",
        "content/content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
